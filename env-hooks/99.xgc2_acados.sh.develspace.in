export ACADOS_SOURCE_DIR="@XGC2_ACADOS_INSTALL_PREFIX@"
export ACADOS_PYTHON_INTERFACE_PATH="${ACADOS_SOURCE_DIR}/interfaces/acados_template/acados_template"
export TERA_PATH="@XGC2_ACADOS_RENDERER@"
if [ -n "${PYTHONPATH:-}" ]; then
  export PYTHONPATH="${ACADOS_SOURCE_DIR}/interfaces/acados_template:${PYTHONPATH}"
else
  export PYTHONPATH="${ACADOS_SOURCE_DIR}/interfaces/acados_template"
fi
if [ -n "${LD_LIBRARY_PATH:-}" ]; then
  export LD_LIBRARY_PATH="@XGC2_ACADOS_INSTALL_PREFIX@/lib:${LD_LIBRARY_PATH}"
else
  export LD_LIBRARY_PATH="@XGC2_ACADOS_INSTALL_PREFIX@/lib"
fi
